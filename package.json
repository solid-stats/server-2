{
  "name": "server-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "format": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/test/integration/**/*.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/test/integration",
    "test:schema": "vitest run src/test/integration/schema.test.ts",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "openapi:export": "tsx src/openapi/export-openapi.ts",
    "openapi:check": "npm run openapi:export && openapi-typescript openapi/server-2.openapi.json -o /tmp/server-2-openapi.d.ts",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run openapi:check && npm run test:coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "amqplib": "^1.0.7",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "fastify": "^5.8.5",
    "kysely": "^0.29.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
