NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://solid:change-me@postgres:5432/solid_stats
RABBITMQ_URL=amqp://solid:change-me@rabbitmq:5672
PARSER_CONTRACT_VERSION=3.0.0
INGEST_PROMOTION_BATCH_SIZE=25
PARSE_JOB_PUBLISH_BATCH_SIZE=25
RUNTIME_POLL_INTERVAL_MS=5000
BOOTSTRAP_ADMIN_STEAM_ID=
PUBLIC_BASE_URL=https://stats.example.com
SESSION_COOKIE_NAME=solid_stats_session
SESSION_TTL_SECONDS=2592000
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=solid-replays
S3_ACCESS_KEY_ID=solid
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
# Sentry/GlitchTip (errors-only). Injected by infra via the server-2-runtime Secret;
# leave SENTRY_DSN empty to disable reporting (SDK no-op). SENTRY_RELEASE is an optional build SHA.
SENTRY_DSN=
SENTRY_RELEASE=

POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
